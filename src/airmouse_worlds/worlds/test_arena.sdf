<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="test_arena">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- ===== WALLS ===== -->
    <!-- macro-equivalent: each wall is a static box, height 2.44m, thickness 0.1m -->

    <!-- Entry corridor, 5m long, 1m clear width, running along +X from origin -->
    <model name="wall_entry_north"><static>true</static>
      <link name="link"><pose>2.5 0.55 1.22 0 0 0</pose>
        <collision name="c"><geometry><box><size>5 0.1 2.44</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5 0.1 2.44</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
    </model>
    <model name="wall_entry_south"><static>true</static>
      <link name="link"><pose>2.5 -0.55 1.22 0 0 0</pose>
        <collision name="c"><geometry><box><size>5 0.1 2.44</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5 0.1 2.44</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
    </model>

    <!-- Junction at x=5..6, opens into Room A (+Y) and Room B (-Y) -->
    <model name="wall_junction_north_stub"><static>true</static>
      <link name="link"><pose>5.05 1.55 1.22 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 2 2.44</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 2 2.44</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
    </model>
    <model name="wall_junction_south_stub"><static>true</static>
      <link name="link"><pose>5.05 -1.55 1.22 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 2 2.44</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 2 2.44</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
    </model>

    <!-- Room A: 2x2m, centered (6, 2.55) -->
    <model name="roomA_far"><static>true</static>
      <link name="link"><pose>7.05 2.55 1.22 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 2 2.44</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 2 2.44</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
    </model>
    <model name="roomA_far_wall"><static>true</static>
      <link name="link"><pose>6 3.55 1.22 0 0 0</pose>
        <collision name="c"><geometry><box><size>2 0.1 2.44</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2 0.1 2.44</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
    </model>

    <!-- Room B: mirror of Room A on -Y side -->
    <model name="roomB_far"><static>true</static>
      <link name="link"><pose>7.05 -2.55 1.22 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 2 2.44</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 2 2.44</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
    </model>
    <model name="roomB_far_wall"><static>true</static>
      <link name="link"><pose>6 -3.55 1.22 0 0 0</pose>
        <collision name="c"><geometry><box><size>2 0.1 2.44</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2 0.1 2.44</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
    </model>

  </world>
</sdf>